# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env before running docker compose:
#   cp .env.example .env
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_DB=note_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend (Django) ---
# When running with Docker Compose, the database host is "db"
DATABASE_URL=postgres://postgres:postgres@db:5432/note_app
SECRET_KEY=django-insecure-note-app-secret-key-change-in-prod-12345
DEBUG=True
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
# Internal Docker network URL (used by Server Actions / Server Components)
API_URL=http://backend:8000
# External browser URL (used by client-side browser requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
