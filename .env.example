# --- PostgreSQL Database ---
POSTGRES_DB=note_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend (Django) ---
DATABASE_URL=postgres://postgres:postgres@db:5432/note_app
SECRET_KEY=django-insecure-note-app-secret-key-change-in-prod-12345
DEBUG=True
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
# API_URL: Used by Server Actions & Server Components (inside Docker network)
API_URL=http://backend:8000
# NEXT_PUBLIC_API_URL: Used by client-side browser code
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# --- AI & MCP Tooling (Optional) ---
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here
